        {"card_id": "b", "board": "main", "finish": "nonfoil", "qty": 4},
        {"card_id": "a", "board": "side", "finish": "nonfoil", "qty": 2},
        {"card_id": "c", "board": "maybe", "finish": "nonfoil", "qty": 1}
      ],
      "owned": {"b|nonfoil": 4},
      "ops": [{"card_id": "a", "finish": "nonfoil", "delta": 2}, {"card_id": "b", "finish": "nonfoil", "delta": 4}],
      "copies": 6
    },

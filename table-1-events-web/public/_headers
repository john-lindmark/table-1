# Cloudflare Pages response headers (https://developers.cloudflare.com/pages/configuration/headers/).
# Unknown paths fall back to index.html automatically (no 404.html), so the app's routes load directly.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Universal links: Apple fetches this without an extension and needs JSON, unredirected.
/.well-known/apple-app-site-association
  Content-Type: application/json

/.well-known/assetlinks.json
  Content-Type: application/json

# Vite's hashed bundles never change under the same name.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

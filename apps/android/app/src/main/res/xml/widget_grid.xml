<?xml version="1.0" encoding="utf-8"?>
<!-- An Insights widget (contract/widgets-2026-10-22.md § Meta widgets): set up on MetaWidgetConfigActivity; placed with
     Modern, Big events, 30 days where the launcher allows (configuration_optional, Android 12+). -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:configure="site.table1.events.widgets.MetaWidgetConfigActivity"
    android:widgetFeatures="reconfigurable|configuration_optional"
    android:description="@string/widget_grid_description"
    android:initialLayout="@layout/widget_loading"
    android:minWidth="250dp"
    android:minHeight="180dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="110dp"
    android:targetCellWidth="4"
    android:targetCellHeight="3"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="10800000"
    android:widgetCategory="home_screen" />

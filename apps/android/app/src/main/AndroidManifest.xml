<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Catalog updates wait for an unmetered network once a pack is installed. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Foreground only: nearby events and the event pin. No background location, ever. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Android 16: the live notification for an event you play or run asks to show as a Live Update. -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <!-- Card scanning only (the join QR uses Google's scanner, which needs no permission). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- Links the app has no screen for go back to the browser (WebLink.kt), so it must see which one is the default. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:name=".T1App"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.Table1">

        <!-- Sentry starts from Telemetry.start (DSN, opt-out, scrubbing), not from its own provider. -->
        <meta-data android:name="io.sentry.auto-init" android:value="false" />

        <!-- The scanner's Latin text model comes from Play services (play-services-mlkit-text-recognition). Without this
             it's fetched on the first scan, and until it arrives every frame fails and nothing is read; with it Play
             fetches it when the app is installed. The CJK models still come on first use (ScanLanguage). barcode_ui is the
             join QR's code scanner (play-services-code-scanner): starting it before it's installed crashes (bug #34). -->
        <meta-data android:name="com.google.mlkit.vision.DEPENDENCIES" android:value="ocr,ocr_japanese,ocr_chinese,ocr_korean,barcode_ui" />

        <!-- Folding, unfolding, turning and resizing (contract/foldables-2026-11-10.md): Compose redraws for the new
             window instead of the activity restarting, so a ranking screen, a tracker picker or a half-typed form
             stays exactly where it was (Android's foldables guidance on continuity). -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|keyboard|keyboardHidden|navigation"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Long-press the icon: Life tracker and Scan cards (as iOS's App Shortcuts). -->
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />

            <!-- table-1.site links open here when the app is installed (contract/universal-links-2026-10-22.md): every
                 page the app has a screen for, the same list as public/.well-known/apple-app-site-association. Anything
                 else under these paths (or a web sign-in coming back) goes back to the browser (WebLink.kt).
                 autoVerify needs /.well-known/assetlinks.json on both hosts (see SETUP.md). -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="table-1.site" />
                <data android:host="www.table-1.site" />
                <data android:path="/" />
                <data android:path="/sign-in" />
                <data android:pathPrefix="/e/" />
                <data android:pathPrefix="/p/" />
                <data android:pathPrefix="/s/" />
                <data android:pathPrefix="/l/" />
                <data android:pathPrefix="/join/" />
                <data android:pathPrefix="/j/" />
                <data android:path="/auth/confirm" />
                <data android:path="/life" />
                <data android:pathPrefix="/life/" />
                <data android:path="/library" />
                <data android:pathPrefix="/library/" />
                <data android:path="/me" />
                <data android:path="/friends" />
                <data android:pathPrefix="/friends/" />
                <data android:path="/sharing" />
                <data android:pathPrefix="/u/" />
            </intent-filter>

            <!-- Sign in with Apple returns here from the browser. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="table1" android:host="auth-callback" />
            </intent-filter>
        </activity>
        <!-- Alert pushes (FCM, data only): Push.kt draws them and registers the token. -->
        <service
            android:name=".util.T1MessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_t1" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="events" />

        <!-- Home screen widgets (contract/widgets-2026-10-22.md), drawn with Glance (widgets/). -->
        <receiver android:name=".widgets.NextEventWidgetReceiver" android:exported="true" android:label="@string/widget_next_name">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_next" />
        </receiver>
        <receiver android:name=".widgets.ValueWidgetReceiver" android:exported="true" android:label="@string/widget_value_name">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_value" />
        </receiver>
        <receiver android:name=".widgets.MatchWidgetReceiver" android:exported="true" android:label="@string/widget_match_name">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_match" />
        </receiver>
        <receiver android:name=".widgets.MetaWidgetReceiver" android:exported="true" android:label="@string/widget_meta_name">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_meta" />
        </receiver>
        <receiver android:name=".widgets.MatchupGridWidgetReceiver" android:exported="true" android:label="@string/widget_grid_name">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_grid" />
        </receiver>
        <receiver android:name=".widgets.ArchetypeWidgetReceiver" android:exported="true" android:label="@string/widget_archetype_name">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_archetype" />
        </receiver>
        <receiver android:name=".widgets.LimitedWidgetReceiver" android:exported="true" android:label="@string/widget_limited_name">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_limited" />
        </receiver>
        <receiver android:name=".widgets.IconWidgetReceiver" android:exported="true" android:label="@string/widget_icon_name">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_icon" />
        </receiver>
        <!-- The card icon widget's settings: which icon card it shows. -->
        <activity android:name=".widgets.IconWidgetConfigActivity" android:exported="true" android:theme="@style/Theme.Table1"
            android:taskAffinity="" android:excludeFromRecents="true">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" /></intent-filter>
        </activity>
        <!-- The Limited cards widget's settings (set, sort, rarities, colors). -->
        <activity android:name=".widgets.LimitedWidgetConfigActivity" android:exported="true" android:theme="@style/Theme.Table1"
            android:taskAffinity="" android:excludeFromRecents="true">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" /></intent-filter>
        </activity>
        <!-- The Insights widgets' settings (format, events, window, archetype). -->
        <activity android:name=".widgets.MetaWidgetConfigActivity" android:exported="true" android:theme="@style/Theme.Table1"
            android:taskAffinity="" android:excludeFromRecents="true">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" /></intent-filter>
        </activity>

        <!-- Quick Settings tiles: Life tracker and Scan cards (iOS's Control Center controls). -->
        <service android:name=".widgets.TrackerTileService" android:exported="true" android:label="@string/control_tracker"
            android:icon="@drawable/ic_shortcut_tracker" android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
            <meta-data android:name="android.service.quicksettings.TOGGLEABLE_TILE" android:value="false" />
        </service>
        <service android:name=".widgets.ScanTileService" android:exported="true" android:label="@string/control_scan"
            android:icon="@drawable/ic_shortcut_scan" android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
            <meta-data android:name="android.service.quicksettings.TOGGLEABLE_TILE" android:value="false" />
        </service>

        <!-- Account photo: the camera writes a full-size shot here before it's cropped to 512 px. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.avatars"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/avatar_paths" />
        </provider>
        <!-- Glance routes clicks through these only inside its lazy lists, which no widget uses. Started without its
             target intent (bug #33, Android 11) the trampoline crashed the app, so both are off; GlanceTrampolineTest. -->
        <activity android:name="androidx.glance.appwidget.action.ActionTrampolineActivity"
            android:enabled="false" tools:replace="android:enabled" />
        <activity android:name="androidx.glance.appwidget.action.InvisibleActionTrampolineActivity"
            android:enabled="false" tools:replace="android:enabled" />
    </application>
</manifest>
